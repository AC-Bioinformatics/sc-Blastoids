# 1.Data: only the README is tracked (raw 10X matrices are downloaded here)
1.Data/*
!1.Data/README.md

# Large data objects (GitHub rejects files over 100 MB)
*.h5
*.h5ad
*.rds
*.mtx
*.mtx.gz
*.tsv.gz
*.loom
*.tar.gz

# CellBender training checkpoints
3.Results/2.CellBender/ckpt/

# R / editor / OS noise
Rplots.pdf
.Rhistory
.RData
.Rproj.user/
.DS_Store
__pycache__/

# Container images (pulled locally, see 2.Scripts/cellbender_container.sh)
*.sif
containers/

# Run logs (written by 2.Scripts/run_pipeline.sh)
3.Results/logs/

# Saved Louvain clusters (reused by Clustering.R)
!3.Results/6.Clustering/Louvain/cluster_metadata.rds

# Separate test runs (SC_RESULTS=test), kept on the server only
test/

# Figures over 50 MB (kept on the server)
3.Results/6.Clustering/Louvain/umap_all_resolutions_combined.pdf
3.Results/8.Pseudotime/flufftail/res0.3/consensus_heatmap.pdf
